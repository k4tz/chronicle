# Database
DATABASE_URL="./dev.db"          # SQLite file path locally. Full PostgreSQL URL when deployed.

# LLM
LLM_PROVIDER="ollama"            # ollama | openai | anthropic
OLLAMA_BASE_URL="http://localhost:8129"
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

DEFAULT_MODEL="llama3.1:8b"
GENERATION_MODEL="llama3.1:8b"
ANALYSIS_MODEL="llama3.1:8b"

# Context Size Configuration
# These values control how much context is included in chapter generation
MODEL_CONTEXT_WINDOW=8192        # Total context window of your model (e.g., 8192, 16384, 32768)
GENERATION_HEADROOM=4096         # Tokens reserved for model output (generation)
                                   # Context budget = (CONTEXT_WINDOW - HEADROOM) * 0.8
                                   # Example: (8192 - 4096) * 0.8 = 3276 tokens for context

# Embeddings (semantic retrieval)
# Local HuggingFace embeddings via transformers.js — no token, no network at
# inference. Enabled by default; set to 0/false to force the TF-IDF lexical
# scorer. Read in server/src/services/retrieval.ts (embeddingsEnabled()).
EMBEDDINGS_ENABLED=1
EMBEDDING_MODEL="Xenova/bge-small-en-v1.5"   # any feature-extraction model on HF

# App
DATA_DIR="./data"
CACHE_BACKEND="memory"           # memory | redis
REDIS_URL=""
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"   # CORS: the Vite client's origin (index.ts)
